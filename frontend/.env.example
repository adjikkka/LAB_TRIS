# Адрес сервера ASP.NET Core (ЛР7). Менять без перезапуска npm run dev нельзя —
# Vite читает .env только при старте.
VITE_API_BASE_URL=http://localhost:5000

# Учебный режим: true — данные отдаёт mock из src/api/mockTickets.js (ЛР6),
# false — запросы идут на настоящий API (ЛР12).
VITE_USE_MOCK=true
